{
  "name": "axomaster",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @axomaster/web --filter @axomaster/api dev",
    "build": "pnpm --filter @axomaster/web build",
    "preview": "pnpm --filter @axomaster/web preview",
    "release": "pnpm build && pnpm --filter @axomaster/api release",
    "db:migrate": "pnpm --filter @axomaster/api db:migrate",
    "db:seed": "pnpm --filter @axomaster/api db:seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
